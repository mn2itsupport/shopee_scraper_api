# Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard (server-rendered /dashboard pages, all-clients view)
ADMIN_DASHBOARD_PASSWORD=change-me

# Scraping
PLAYWRIGHT_HEADLESS=true
MAX_CONCURRENT_SCRAPES=3
SCRAPE_TIMEOUT_SECONDS=30
CAPTCHA_MAX_RETRIES=2
# BROWSER_MODE=brightdata_cdp: connect to Bright Data's Scraping Browser over
# CDP instead of launching Chromium locally (handles proxy rotation,
# fingerprinting, and CAPTCHA solving server-side; PROXY_MODE below is
# ignored in this mode). Leave BROWSER_MODE unset/"local" to launch locally.
# BROWSER_MODE=brightdata_unlocker_api: no browser/Playwright at all — each
# scrape is one POST to Bright Data's Web Unlocker REST API, which renders
# the page server-side and returns plain HTML. Needs BRIGHTDATA_API_TOKEN (an
# account-level Bearer token from Bright Data's Account Settings > API Keys —
# NOT a zone password) and BRIGHTDATA_UNLOCKER_ZONE below. Only site adapters
# that implement fetch_pdp_via_unlocker_api support this mode.
# BROWSER_MODE=brightdata_dataset_api: no browser/Playwright either — each
# scrape triggers a job on one of Bright Data's maintained per-site Dataset
# API scrapers (their infrastructure handles anti-bot/CAPTCHA entirely
# server-side) via an async trigger/poll/snapshot flow, returning
# already-structured JSON (price included) instead of raw HTML. Needs
# BRIGHTDATA_API_TOKEN above and BRIGHTDATA_SHOPEE_DATASET_ID below (the
# dataset_id, looks like "gd_xxxxxxxx", from your Bright Data dashboard's
# Shopee scraper). Currently only shopee_th implements
# fetch_pdp_via_dataset_api.
BROWSER_MODE=local
BRIGHTDATA_SHOPEE_DATASET_ID=
BRIGHTDATA_WS_ENDPOINT=wss://brd-customer-xxxx-zone-scraping_browserN:password@brd.superproxy.io:9222
BRIGHTDATA_API_TOKEN=

# shopee_th only: which transport this one site uses, independent of
# BROWSER_MODE above (see ShopeeTHScraper.browser_mode_override) — every
# automated/headless approach against Shopee TH still hits its anti-bot
# layer somewhere, so "apify" (routes through a third-party Apify actor
# instead, running entirely on their infrastructure) is worth trying once
# you have a token. Only shopee_th implements fetch_pdp_via_apify.
SHOPEE_TH_BROWSER_MODE_OVERRIDE=local
# shopee_vn only: same escape hatch as SHOPEE_TH_BROWSER_MODE_OVERRIDE above
# (see ShopeeVNScraper.browser_mode_override) — empty by default (stays on
# the global BROWSER_MODE, same as shopee_br). Set to "apify" if shopee_vn
# starts hanging/timing out on the Bright Data transport the way shopee_th
# did.
SHOPEE_VN_BROWSER_MODE_OVERRIDE=
# shopee_br only: same escape hatch (see ShopeeBRScraper.browser_mode_override)
# — empty by default (stays on the fast global BROWSER_MODE, Bright Data's
# Web Unlocker). Set to "local" to instead capture Shopee's real internal
# pdp/get_pc item object (price tiers, stock, tier_variations, shop
# internals, ...) via a real browser page instead of the Unlocker's thinner
# ld+json-derived `raw` field. Pair with PROXY_MODE=brightdata_residential
# below so the browser's exit IP isn't a raw datacenter IP.
SHOPEE_BR_BROWSER_MODE_OVERRIDE=
APIFY_API_TOKEN=
APIFY_SHOPEE_PRODUCT_DETAIL_ACTOR_ID=gio21/shopee-product-detail
# shopee_vn only (see ShopeeScraper._apify_fetch_xtracto) — a second Apify
# actor used only for shopee_vn's apify path, since the actor above
# consistently nulls price/rating for shopee.vn specifically (confirmed
# live) while this one returns real values for the same country.
APIFY_XTRACTO_SHOPEE_ACTOR_ID=xtracto/shopee-scraper

# Optional: log into a real Shopee account once at startup and reuse that
# session for scraping instead of anonymous browsing. Understand the risk to
# the account before enabling — see app/scrapers/shopee_login.py.
# This pair is shopee_br-specific.
SHOPEE_LOGIN_ENABLED=false
SHOPEE_LOGIN_USERNAME=
SHOPEE_LOGIN_PASSWORD=

# Same as above but for shopee_th's own account — in practice, don't rely on
# this: every automated shopee_th login attempt (local Chromium, Bright
# Data's Scraping Browser) got blocked by Shopee's own traffic-verification
# wall before completing. Use SHOPEE_TH_USE_PERSISTENT_PROFILE below instead.
SHOPEE_TH_LOGIN_ENABLED=false
SHOPEE_TH_LOGIN_USERNAME=
SHOPEE_TH_LOGIN_PASSWORD=

# shopee_th only: reuse one persistent Chromium profile
# (browser_profiles/shopee_th/, gitignored) across every scrape and app
# restart, instead of a fresh throwaway context per request — shopee_th
# always uses the browser transport regardless of BROWSER_MODE
# (ShopeeTHScraper.browser_mode_override). Seed it once with
# `python scripts/shopee_th_manual_login.py`, a real visible browser window
# you log into by hand, since automated login (above) doesn't get past
# Shopee TH's traffic-verification wall. Pair with
# PROXY_MODE=brightdata_residential below (country-targeted to "th") so the
# profile's exit IP matches its account's expected country.
SHOPEE_TH_USE_PERSISTENT_PROFILE=true

# How often (minutes) to re-check whether the shopee_th persistent profile's
# session is still authenticated, on top of the once-at-startup check — a
# session can go stale hours into a long-running process.
SHOPEE_TH_SESSION_CHECK_INTERVAL_MINUTES=30
# Optional: POST {"text": "..."} (Slack incoming webhook-compatible) to this
# URL only when the session's valid/invalid state changes, so you find out
# the moment scripts/shopee_th_manual_login.py needs rerunning instead of
# only seeing it in the logs. Leave empty to rely on the log warning alone.
SHOPEE_TH_SESSION_ALERT_WEBHOOK_URL=

# PROXY_MODE=static_list (default): round-robins PROXY_LIST, a JSON array of
# proxy URLs, e.g. ["http://user:pass@host:port", "http://host2:port2"].
# Leave PROXY_LIST empty to scrape without a proxy.
PROXY_MODE=static_list
PROXY_LIST=[]

# PROXY_MODE=rotating_session: for residential-proxy vendors that expose one
# sticky gateway and rotate the exit IP per connection based on a session id
# embedded in the username (Bright Data, Oxylabs, Smartproxy/Decodo, IPRoyal,
# ...). PROXY_USERNAME_TEMPLATE must contain a {session} placeholder, e.g.
# "myuser-session-{session}"; a fresh random session id is generated per request.
PROXY_GATEWAY_SERVER=
PROXY_USERNAME_TEMPLATE=
PROXY_PASSWORD=

# PROXY_MODE=brightdata_unlocker: routes through Bright Data's Web Unlocker
# product as a forward proxy (only takes effect when BROWSER_MODE=local —
# Playwright still renders locally, so the existing PDP-JSON network-capture
# scraping strategy is unaffected; Web Unlocker just unblocks what comes back
# through it). Requires a separate "Unlocker"-type zone in Bright Data, not
# the Scraping Browser zone used by BRIGHTDATA_WS_ENDPOINT above.
BRIGHTDATA_CUSTOMER_ID=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_UNLOCKER_PASSWORD=

# PROXY_MODE=brightdata_residential: a static residential/ISP Bright Data
# zone, country-targeted per request via each site adapter's
# unlocker_country (a "-country-<cc>" username suffix). Only takes effect
# when BROWSER_MODE=local. Needs BRIGHTDATA_CUSTOMER_ID above too.
BRIGHTDATA_RESIDENTIAL_ZONE=
BRIGHTDATA_RESIDENTIAL_PASSWORD=

# Rate limiting (in-memory, single-instance MVP; see README for Redis upgrade path)
DEFAULT_REQUESTS_PER_MINUTE=30

# Randomized delay (ms) before each scrape attempt, so concurrent requests
# don't all hit the target in lockstep. Set both to 0 to disable.
PRE_SCRAPE_JITTER_MS_MIN=150
PRE_SCRAPE_JITTER_MS_MAX=500

# Set to false to skip persisting each successful scrape's product data to
# the pdp_data table (usage_logs rows for quota/dashboard tracking are still
# always written regardless of this setting).
STORE_PDP_DATA=true

# Logging: app logs go to stdout and to a rotating file on disk
# (LOG_DIR/LOG_FILE), rotated at LOG_MAX_BYTES with LOG_BACKUP_COUNT kept.
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
