# Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard (server-rendered /dashboard pages, all-clients view)
ADMIN_DASHBOARD_PASSWORD=change-me

# Scraping
PLAYWRIGHT_HEADLESS=true
MAX_CONCURRENT_SCRAPES=3
SCRAPE_TIMEOUT_SECONDS=30
CAPTCHA_MAX_RETRIES=2
# BROWSER_MODE=brightdata_cdp: connect to Bright Data's Scraping Browser over
# CDP instead of launching Chromium locally (handles proxy rotation,
# fingerprinting, and CAPTCHA solving server-side; PROXY_MODE below is
# ignored in this mode). Leave BROWSER_MODE unset/"local" to launch locally.
# BROWSER_MODE=brightdata_unlocker_api: no browser/Playwright at all — each
# scrape is one POST to Bright Data's Web Unlocker REST API, which renders
# the page server-side and returns plain HTML. Needs BRIGHTDATA_API_TOKEN (an
# account-level Bearer token from Bright Data's Account Settings > API Keys —
# NOT a zone password) and BRIGHTDATA_UNLOCKER_ZONE below. Only site adapters
# that implement fetch_pdp_via_unlocker_api support this mode.
BROWSER_MODE=local
BRIGHTDATA_WS_ENDPOINT=wss://brd-customer-xxxx-zone-scraping_browserN:password@brd.superproxy.io:9222
BRIGHTDATA_API_TOKEN=

# Optional: log into a real Shopee account once at startup and reuse that
# session for scraping instead of anonymous browsing. Understand the risk to
# the account before enabling — see app/scrapers/shopee_login.py.
SHOPEE_LOGIN_ENABLED=false
SHOPEE_LOGIN_USERNAME=
SHOPEE_LOGIN_PASSWORD=

# PROXY_MODE=static_list (default): round-robins PROXY_LIST, a JSON array of
# proxy URLs, e.g. ["http://user:pass@host:port", "http://host2:port2"].
# Leave PROXY_LIST empty to scrape without a proxy.
PROXY_MODE=static_list
PROXY_LIST=[]

# PROXY_MODE=rotating_session: for residential-proxy vendors that expose one
# sticky gateway and rotate the exit IP per connection based on a session id
# embedded in the username (Bright Data, Oxylabs, Smartproxy/Decodo, IPRoyal,
# ...). PROXY_USERNAME_TEMPLATE must contain a {session} placeholder, e.g.
# "myuser-session-{session}"; a fresh random session id is generated per request.
PROXY_GATEWAY_SERVER=
PROXY_USERNAME_TEMPLATE=
PROXY_PASSWORD=

# PROXY_MODE=brightdata_unlocker: routes through Bright Data's Web Unlocker
# product as a forward proxy (only takes effect when BROWSER_MODE=local —
# Playwright still renders locally, so the existing PDP-JSON network-capture
# scraping strategy is unaffected; Web Unlocker just unblocks what comes back
# through it). Requires a separate "Unlocker"-type zone in Bright Data, not
# the Scraping Browser zone used by BRIGHTDATA_WS_ENDPOINT above.
BRIGHTDATA_CUSTOMER_ID=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_UNLOCKER_PASSWORD=

# PROXY_MODE=brightdata_residential: a static residential/ISP Bright Data
# zone, country-targeted per request via each site adapter's
# unlocker_country (a "-country-<cc>" username suffix). Only takes effect
# when BROWSER_MODE=local. Needs BRIGHTDATA_CUSTOMER_ID above too.
BRIGHTDATA_RESIDENTIAL_ZONE=
BRIGHTDATA_RESIDENTIAL_PASSWORD=

# Rate limiting (in-memory, single-instance MVP; see README for Redis upgrade path)
DEFAULT_REQUESTS_PER_MINUTE=30

# Randomized delay (ms) before each scrape attempt, so concurrent requests
# don't all hit the target in lockstep. Set both to 0 to disable.
PRE_SCRAPE_JITTER_MS_MIN=150
PRE_SCRAPE_JITTER_MS_MAX=500

# Set to false to skip persisting each successful scrape's product data to
# the pdp_data table (usage_logs rows for quota/dashboard tracking are still
# always written regardless of this setting).
STORE_PDP_DATA=true

# Logging: app logs go to stdout and to a rotating file on disk
# (LOG_DIR/LOG_FILE), rotated at LOG_MAX_BYTES with LOG_BACKUP_COUNT kept.
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
